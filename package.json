{
  "name": "sylva-life-os",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:opengym": "npm --prefix opengym/frontend run build -- --outDir ../../public/opengym --emptyOutDir",
